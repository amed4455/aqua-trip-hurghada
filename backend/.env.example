PORT=4001

# رقم واتساب صاحب الصفحة (بالصيغة الدولية بدون + أو صفر، مثال مصر: 201xxxxxxxxx)
OWNER_NUMBER=201000000000

# نطاق الفرونت اند المسموح له يتواصل مع الباك اند (اسيبها * لو بتفتح الصفحة كملف محلي file://)
FRONTEND_ORIGIN=*

# عنوان الفرونت اند الفعلي (بدون * ) - يستخدم لتحويل المستخدم بعد تسجيل الدخول بجوجل/فيسبوك
FRONTEND_URL=http://localhost:8082

# عنوان الباك اند نفسه زي ما هيبقى متاح من برة (لازم يتطابق مع الـ Authorized redirect URI المسجل في جوجل/فيسبوك)
PUBLIC_BACKEND_URL=http://localhost:4001

# بيانات تطبيق Google OAuth (من https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# اختياري: لو سايبها فاضية هتتبني تلقائي من PUBLIC_BACKEND_URL + /api/auth/google/callback
GOOGLE_REDIRECT_URI=

# بيانات تطبيق Facebook Login (من https://developers.facebook.com/apps)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# اختياري: لو سايبها فاضية هتتبني تلقائي من PUBLIC_BACKEND_URL + /api/auth/facebook/callback
FACEBOOK_REDIRECT_URI=
